# Public site origin for canonical URLs, sitemap, OG (set in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres (free tier) — required
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Google AI Studio Gemini key (free tier, no billing) — required for classification
GOOGLE_GENERATIVE_AI_API_KEY=
# Comma-separated pool — rotates when a key hits daily quota (prefer this in GitHub Actions)
# Example: key1,key2,key3
GOOGLE_GENERATIVE_AI_API_KEYS=

# Product Hunt developer token (optional upgrade).
# Without it, Toolshelf uses the public Atom feed (no auth).
# Token unlocks real vote/comment counts + thumbnails via GraphQL.
# https://api.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=

# Protects /api/cron/* and ingest routes
CRON_SECRET=change-me-to-a-long-random-string

# Analytics (optional — product events already fire; set any of these to connect a tool)
# See ANALYTICS.md
# NEXT_PUBLIC_GTM_ID=GTM-XXXX
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=toolshelf.space
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_ANALYTICS_DEBUG=1
